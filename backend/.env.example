# 默认使用 MinIO，可切换为 aliyun。
STORAGE_TYPE=minio

OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BUCKET=rbac
OSS_ACCESS_KEY_ID=replace-with-your-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-your-access-key-secret

MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=rbac
MINIO_ACCESS_KEY=replace-with-your-minio-access-key
MINIO_SECRET_KEY=replace-with-your-minio-secret-key
